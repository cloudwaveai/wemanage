# 复制为 .env 后填写。init.sh 会自动生成带 __ 占位的密钥。

# 对外域名（Caddy 自动签发 TLS）
GATEWAY_DOMAIN=ai.example.com

# 网关对外的公开地址（写进员工的 Codex 配置片段、飞书 OAuth 回调）
PUBLIC_BASE_URL=https://ai.example.com

# PostgreSQL 密码（init.sh 生成）
POSTGRES_PASSWORD=

# 数据库落盘加密主密钥：32 字节的 base64。生成：openssl rand -base64 32
MASTER_KEY=

# 网关 <-> CPA 的内部 Key，以及 CPA 管理密钥（init.sh 生成，需与 cpa/config.yaml 一致）
CPA_API_KEY=
CPA_MANAGEMENT_KEY=

# 飞书自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn

# 首批超级管理员的飞书 open_id，逗号分隔（首次同步前用于建种子）
BOOTSTRAP_SUPER_ADMINS=

# AI 周报使用的 OpenAI 兼容端点（务必用独立 API Key 的小模型，切勿用员工订阅）
REPORT_LLM_BASE_URL=https://api.openai.com/v1
REPORT_LLM_API_KEY=
REPORT_LLM_MODEL=gpt-5-mini

# 出口 IP 自检使用的回显服务
EGRESS_ECHO_URL=https://api.ipify.org?format=text

# CPA 镜像：固定到已核对过行为的版本（前缀隔离、透传请求头、回传额度头）。升级前先对照新版源码/实测再改
CPA_IMAGE=eceasy/cli-proxy-api:v7.3.18

# 数据库位置
# 默认：本机编排里自带 postgres（COMPOSE_PROFILES=localdb）。
# 数据库放在别处（例如国内云 RDS）：删掉下面这行的 localdb，并填写 DATABASE_URL。
COMPOSE_PROFILES=localdb
# DATABASE_URL=postgres://gateway:密码@rds-地址:5432/gateway?sslmode=require&connect_timeout=10

# 对话原文（blob）存储后端：postgres（默认，字节存库）或 s3（字节存对象存储，元数据仍在库）
# 生产建议用 s3 —— 把不断增长的原文从系统盘挪到便宜的对象存储，避免撑爆磁盘
BLOB_BACKEND=postgres
# 当 BLOB_BACKEND=s3 时填写（示例为 Cloudflare R2）
# S3_ENDPOINT=<账号ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ai-seat-logs
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=true

# 防 Key 外泄：IP 归属地库（可选）。把 ip2region 的 .xdb 文件放到 deploy/geoip/ 下，
# 这里填容器内路径。不配置则不做归属地/机房判断，其它风控照常工作。
# GEOIP_DB=/data/geoip/ip2region.xdb
# 网关前面是 Caddy（内网地址）时，信任它写入的 X-Forwarded-For 来取员工真实 IP。
# 只在网关端口没有直接暴露到公网时保持 true。
TRUST_PROXY_HEADERS=true

# 仅本地联调时置 true，可用 /api/auth/dev 免飞书登录；生产必须为 false
DEV_LOGIN=false
